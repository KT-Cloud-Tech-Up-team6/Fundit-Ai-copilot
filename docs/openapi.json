{
  "openapi": "3.1.0",
  "info": {
    "title": "Fundit AI Copilot API",
    "description": "라이브 채팅 AI 자동 응대 — 기능 A(자동 답변) / 기능 B(자주 나오는 질문 요약)",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/funding-ai/lives/{live_id}/prepare": {
      "post": {
        "tags": [
          "A. 라이브 자동 답변"
        ],
        "summary": "Prepare",
        "description": "판매자 상품정보를 색인한다. 색인 전 comments 호출은 409 NOT_PREPARED.\n\nMVP 참고: 현 단계는 단일 상품(내장 KB) 검증 단계로, 전달된 knowledge 는\n저장·검증만 하고 답변 근거는 내장 상품 KB 를 사용한다. 멀티 상품 KB 동적\n교체는 다음 페이즈 (BE 계약은 동일 유지).",
        "operationId": "prepare_api_v1_funding_ai_lives__live_id__prepare_post",
        "parameters": [
          {
            "name": "live_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Live Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
