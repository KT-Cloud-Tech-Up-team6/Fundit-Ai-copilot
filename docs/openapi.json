  "components": {
    "schemas": {
      "CommentIn": {
        "properties": {
          "comment_id": {
            "type": "string",
            "title": "Comment Id"
          },
          "text": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Text"
          },
          "at_ms": {
            "type": "integer",
            "title": "At Ms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "comment_id",
          "text"
        ],
        "title": "CommentIn"
      },
      "CommentsBody": {
        "properties": {
          "comments": {
            "items": {
              "$ref": "#/components/schemas/CommentIn"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Comments"
          }
        },
        "type": "object",
        "required": [
          "comments"
        ],
        "title": "CommentsBody"
      },
      "ContextBody": {
        "properties": {
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "broadcast": {
            "additionalProperties": true,
            "type": "object",
            "title": "Broadcast",
            "default": {}
          },
          "funding": {
            "additionalProperties": true,
            "type": "object",
            "title": "Funding",
            "default": {}
          },
          "extra_slots": {
            "additionalProperties": true,
            "type": "object",
            "title": "Extra Slots",
            "default": {}
          }
        },
        "type": "object",
        "title": "ContextBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KnowledgeChunk": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "strict": {
            "type": "boolean",
            "title": "Strict",
            "default": false
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "category",
          "text"
        ],
        "title": "KnowledgeChunk"
      },
      "PrepareBody": {
        "properties": {
          "product_category": {
            "type": "string",
            "title": "Product Category"
          },
          "knowledge": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeChunk"
            },
            "type": "array",
            "minItems": 1,
            "title": "Knowledge"
          }
        },
        "type": "object",
        "required": [
          "product_category",
          "knowledge"
        ],
        "title": "PrepareBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
