# ── 인증 방법 A (권장·간단): API 키 ─────────────────────────────
# Google AI Studio (https://aistudio.google.com/apikey) 에서 발급.
# 발급 시 GCP 프로젝트를 선택하면 과금이 그 프로젝트로 잡힌다 →
# 프로젝트에 무료 크레딧(무료 체험)이 있으면 크레딧에서 차감됨.
GEMINI_API_KEY=your-key-here

# ── 인증 방법 B: GCP Vertex AI 직접 호출 ────────────────────────
# API 키 대신 gcloud 인증으로 호출하려면 아래 3개를 설정하고
# 터미널에서 `gcloud auth application-default login` 실행.
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# 사용 모델 (기본값 gemini-3.5-flash-lite, 필요 시 교체)
GEMINI_MODEL=gemini-3.5-flash-lite

# 1이면 strict가 아닌 FAQ 답변을 라이브 채팅 톤으로 리라이트 (기본 0 = KB 원문 그대로)
O_PART_REPHRASE=0

# ── 라이브 목방송 테스트 (webtest) ──────────────────────────────
# 입장 비밀번호. 안 쓰면 기본값 team-only
SITE_PASSWORD=team-only
# (선택) 목영상 주소를 미리 지정. 화면의 [영상 업로드]/[영상 URL] 버튼으로 대체 가능
# VIDEO_URL=https://youtu.be/...

# V10 비용 산정용 단가 (USD / 1M tokens). 입력하면 run_eval 이 1,000건 비용을 추정한다.
# 공식 가격표(https://ai.google.dev/pricing) 확인 후 기입.
# GEMINI_PRICE_IN_PER_1M=0
# GEMINI_PRICE_OUT_PER_1M=0
